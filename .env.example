# API kök adresi (production'da HTTPS)
EXPO_PUBLIC_API_URL=http://localhost:3000
# development | staging | production — boş bırakılırsa 'production' kabul edilir
EXPO_PUBLIC_APP_ENV=development

# Destek e-postası (Ayarlar → Destek, Talep ve Öneri; sitenin /destek sayfası)
EXPO_PUBLIC_SUPPORT_EMAIL=destek@psikoal.com
# Yasal metinler sitenin kendi sayfalarıdır (src/app/(site)): <site>/gizlilik, /kosullar, /kvkk.
# Site ve web uygulaması tek derleme/tek alan adı; yerelde `npm run web` (localhost:8081).
# Production'da https zorunlu, ör. https://psikoal-web.onrender.com/gizlilik (alan adı alınınca değişir).
EXPO_PUBLIC_PRIVACY_URL=http://localhost:8081/gizlilik
EXPO_PUBLIC_TERMS_URL=http://localhost:8081/kosullar
EXPO_PUBLIC_KVKK_URL=http://localhost:8081/kvkk
# Mağaza sayfası (opsiyonel; uygulama içi değerlendirme açılamazsa kullanılır)
EXPO_PUBLIC_STORE_URL=
# Web sitesinin kök adresi (opsiyonel; kanonik adres ve og:url), ör. https://psikoal.com
EXPO_PUBLIC_SITE_URL=
# Tanıtım sayfasındaki mağaza rozetleri (opsiyonel; boşsa "Yakında")
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
